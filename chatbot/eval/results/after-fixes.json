    {
     "sql": "SELECT \n  (SELECT COUNT(*) FROM country_medals WHERE sport = 'Swimming' AND medal = 'Gold' AND country = 'USA') * 100.0 / \n  (SELECT COUNT(*) FROM country_medals WHERE sport = 'Swimming' AND medal = 'Gold') AS share,\n  (SELECT COUNT(*) FROM country_medals WHERE sport = 'Swimming' AND medal = 'Gold' AND country = 'USA') AS usa_golds,\n  (SELECT COUNT(*) FROM country_medals WHERE sport = 'Swimming' AND medal = 'Gold') AS total_golds\n",
