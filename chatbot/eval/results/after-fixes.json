  "f-usa-swimming-share": {
   "id": "f-usa-swimming-share",
   "question": "What share of all Olympic swimming gold medals has the USA won?",
   "category": "findings",
   "split": "dev",
   "status": "ok",
   "text": "The USA has won 246 out of 562 swimming gold medals, which is 43.8% of the total. A team medal counts once for the country. Would you like to see the top countries in swimming?",
