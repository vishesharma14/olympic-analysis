  "f-russia-medallist-rate": {
   "id": "f-russia-medallist-rate",
   "question": "Which country turns the largest share of its athletes into medallists?",
   "category": "findings",
   "split": "test",
   "status": "ok",
   "text": "Among countries with at least 1,000 Summer Olympians, Russia turns the largest share of its athletes into medallists at 48.6%, with 2,181 of its 4,486 athletes winning at least one medal. Russia includes the Soviet Union and the 1992 Unified Team.",
   "sql_runs": [
    {
     "sql": "SELECT country, COUNT(DISTINCT athlete_id) AS total_athletes, \n       SUM(CASE WHEN has_medal > 0 THEN 1 ELSE 0 END) AS medallists,\n       ROUND(100.0 * SUM(CASE WHEN has_medal > 0 THEN 1 ELSE 0 END) / COUNT(DISTINCT athlete_id), 1) AS pct\nFROM (\n    SELECT country, athlete_id, MAX(CASE WHEN medal IS NOT NULL THEN 1 ELSE 0 END) AS has_medal\n    FROM summer_entries\n    WHERE country IS NOT NULL\n    GROUP BY country, athlete_id\n)\nGROUP BY country\nHAVING COUNT(DISTINCT athlete_id) >= 1000\nORDER BY pct DESC\nLIMIT 5",
     "row_count": 5,
     "truncated": false,
     "error": null,
     "preview": [
