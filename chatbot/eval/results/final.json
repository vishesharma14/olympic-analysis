  "f-usa-swimming-share": {
   "id": "f-usa-swimming-share",
   "question": "What share of all Olympic swimming gold medals has the USA won?",
   "category": "findings",
   "split": "dev",
   "status": "ok",
   "text": "The USA has won 246 out of 562 swimming gold medals, which is a share of 43.8%. A team or relay medal counts once for the country.",
   "sql_runs": [
    {
     "sql": "SELECT \n  ROUND(100.0 * SUM(CASE WHEN country = 'USA' AND medal = 'Gold' THEN 1 ELSE 0 END) / SUM(CASE WHEN medal = 'Gold' THEN 1 ELSE 0 END), 1) AS usa_share,\n  SUM(CASE WHEN country = 'USA' AND medal = 'Gold' THEN 1 ELSE 0 END) AS usa_golds,\n  SUM(CASE WHEN medal = 'Gold' THEN 1 ELSE 0 END) AS total_golds\nFROM country_medals\nWHERE sport = 'Swimming'",
     "row_count": 1,
